{
    "version": "2.0.0",
    "options": {
        "env": {
            "PATH": "C:\\ST\\STM32CubeIDE_2.2.0\\STM32CubeIDE\\plugins\\com.st.stm32cube.ide.mcu.externaltools.make.win32_2.2.200.202604021615\\tools\\bin;${env:PATH}"
        }
    },
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "make -j8",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": []
        },
        {
            "label": "Rebuild",
            "type": "shell",
            "command": "make clean && make -j8",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Flash",
            "type": "shell",
            "command": "make flash",
            "dependsOn": "Build",
            "problemMatcher": []
        },
        {
            "label": "Flash only (no build)",
            "type": "shell",
            "command": "make flash-only",
            "problemMatcher": []
        },
        {
            "label": "Reset target",
            "type": "shell",
            "command": "make reset",
            "problemMatcher": []
        }
    ]
}
